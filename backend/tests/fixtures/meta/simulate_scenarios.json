{
  "_ghi_chu": [
    "Kịch bản cho `python -m app.mock.simulate`. Giờ theo múi giờ workspace (Asia/Ho_Chi_Minh).",
    "at: 'N HH:MM[:SS]' = ngày thứ N tính từ ngày gốc (hôm nay - 40 ngày); 'now-Xs' = X giây trước lúc chạy.",
    "send: in (khách nhắn), echo (Trang trả lời), referral (bấm quảng cáo), leadgen (gửi form), resend (gửi lại bước trước, khác body).",
    "assign: đổi người phụ trách Trang tại thời điểm at (tài khoản theo phần trước @ của email demo).",
    "Khách là nhãn A, B...: mỗi lần chạy sinh PSID mới. Không dùng tên hay SĐT thật."
  ],
  "scenarios": [
    {
      "key": "in_hours",
      "title": "Trong giờ: 09:00 → 09:12",
      "page": "FISS",
      "steps": [
        {
          "send": "in",
          "customer": "A",
          "at": "0 09:00"
        },
        {
          "send": "echo",
          "customer": "A",
          "at": "0 09:12"
        }
      ],
      "expect": [
        {
          "customer": "A",
          "minutes": 12,
          "owner": "staff187",
          "status": "contacted"
        }
      ]
    },
    {
