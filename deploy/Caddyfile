# Caddy tự lấy chứng chỉ HTTPS cho APP_DOMAIN (Let's Encrypt).
# Qua Cloudflare Tunnel (docker-compose.tunnel.yml, decisions.md mục Q): CADDY_SITE_PREFIX=http://,
# Caddy chỉ phục vụ HTTP trong mạng Docker, Cloudflare giữ HTTPS.
{
	servers {
		# Chỉ tin CF-Connecting-IP từ cloudflared (mạng edge). Không có tunnel: không tin ai.
		trusted_proxies static {$TRUSTED_PROXY_CIDR:127.0.0.1/32}
		client_ip_headers CF-Connecting-IP
	}
}

{$CADDY_SITE_PREFIX}{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# /readyz chỉ dùng trong mạng nội bộ Docker, không mở ra ngoài.
	@backend path /api/* /webhooks/* /healthz
	handle @backend {
		reverse_proxy backend:8000 {
			# Backend chỉ thấy IP thật đã xác định ở trên, không nhận X-Forwarded-For khách tự gửi.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Service worker và manifest phải luôn lấy bản mới, nếu không máy người dùng giữ bản cũ.
	@pwa path /sw.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache"

	handle {
		root * /srv
		# /privacy, /data-deletion: trang tĩnh trong thư mục cùng tên (decisions.md mục U1).
		try_files {path} {path}/index.html /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
