# =====================================================================
# Mẫu cấu hình. Sao chép thành .env rồi điền giá trị thật.
# KHÔNG commit file .env. KHÔNG dán mã truy cập vào chat hay tài liệu.
# =====================================================================

# ---------- Ứng dụng ----------
# development | staging | production
APP_ENV=development
# tên miền công khai (cần HTTPS để nhận webhook)
APP_BASE_URL=https://app.example.vn
# chuỗi ngẫu nhiên dài, dùng ký phiên đăng nhập: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO

# Bật để chạy bằng dữ liệu giả lập, không gọi Graph API thật
MOCK_MODE=true

# ---------- Cơ sở dữ liệu & hàng đợi ----------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=fanpage
# Tài khoản quản trị: chỉ dùng chạy migration và lệnh quản trị (bỏ qua RLS)
POSTGRES_USER=fanpage
POSTGRES_PASSWORD=
# Tài khoản ứng dụng: API và worker dùng tài khoản này, bị Row-Level Security giới hạn theo workspace
POSTGRES_APP_USER=fanpage_app
POSTGRES_APP_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ---------- Meta / Facebook ----------
META_APP_ID=
# dùng kiểm tra chữ ký webhook X-Hub-Signature-256
META_APP_SECRET=
# ví dụ v23.0 — kiểm tra phiên bản mới nhất trên developers.facebook.com
META_GRAPH_VERSION=
# chuỗi tự đặt, nhập giống hệt trong phần Webhooks của ứng dụng Meta
META_WEBHOOK_VERIFY_TOKEN=

# Khóa mã hóa mã truy cập người dùng hệ thống lưu trong DB (Fernet)
# Tạo: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Mất khóa này thì phải dán lại mã của mọi BM.
TOKEN_ENCRYPTION_KEY=

# Mã truy cập của các BM KHÔNG đặt ở đây.
# Chủ sở hữu dán mã qua màn hình "Kết nối BM"; hệ thống mã hóa và lưu vào DB.

# ---------- Quy tắc đo lường (mặc định, sửa được trong Cài đặt) ----------
WORK_HOURS_START=08:00
WORK_HOURS_END=22:00
SLOW_REPLY_MINUTES=30
RESULT_DEADLINE_HOURS=48
LEAD_SESSION_GAP_DAYS=30
POSTS_PER_WEEK_TARGET=5
MIN_LEADS_FOR_RANKING=10

# ---------- Tài khoản quản trị đầu tiên ----------
BOOTSTRAP_WORKSPACE_NAME=
BOOTSTRAP_OWNER_EMAIL=
# tối thiểu 10 ký tự; hệ thống bắt đổi ở lần đăng nhập đầu
BOOTSTRAP_OWNER_PASSWORD=

# ---------- Cảnh báo & báo cáo ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
